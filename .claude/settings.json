{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)"
    ],
    "ask": [
      "Bash(rm *)",
      "Edit(public/assets/**)",
      "Edit(assets/**)",
      "Edit(supabase/migrations/**)",
      "Edit(supabase/checks/**)",
      "Bash(git push origin --delete *)",
      "Bash(git push --delete *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(supabase *)",
      "Bash(psql *)",
      "Bash(netlify *)"
    ]
  }
}
