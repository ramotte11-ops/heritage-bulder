# Heritage Hommage — environment variables
#
# Copy to .env.local for local development. Names only — never put a real
# value in this file or commit one anywhere. See README.md and
# supabase/README.md for how these are used.
#
# The app builds, runs, and serves its current pages with ALL of these
# unset. Nothing here is required until a future mission actually calls
# the Supabase adapters in lib/adapters/supabase/.

# --- Public: safe to expose in the browser -----------------------------
# Next.js only bundles env vars prefixed NEXT_PUBLIC_ into browser code.
# Everything below this section is server-only, automatically, as long as
# it is only read from server-side files (never imported into a
# "use client" component).

# Supabase project URL. Find it in the Supabase dashboard under
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key, from the same screen. Safe to expose:
# every request made with it is still subject to Row Level Security
# (see supabase/README.md) — it grants no access on its own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this deployment (e.g. http://localhost:3000 locally, or
# the real Netlify URL in production/preview). Used only to build the
# Magic Link's redirect target (app/auth/actions.ts) — must exactly
# match an entry in the Supabase project's Auth -> URL Configuration ->
# Redirect URLs allowlist, or the magic link fails. Not a secret: only
# ever a base URL.
NEXT_PUBLIC_SITE_URL=

# --- Server-only: never prefix these NEXT_PUBLIC_ -----------------------

# Supabase service role key, from the same screen. BYPASSES Row Level
# Security entirely. Never expose this to the browser. Only used by
# lib/supabase/service-role-client.ts for trusted server-side operations
# — nothing calls it yet.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings -> Database),
# for migration tooling only — e.g.
# `psql "$SUPABASE_DB_URL" -f supabase/migrations/<file>.sql`.
# The application itself never reads this.
SUPABASE_DB_URL=

# --- Etsy channel (Mission 019B) — ALL server-only ---------------------
# The app builds, runs and serves every page with all of these unset:
# /activate then shows the activation-key form alone and never offers the
# Etsy button (lib/integration/etsy/config.ts).
#
# NEVER prefix any of these NEXT_PUBLIC_. They are read only from
# server-side modules, which is what keeps them out of the browser
# bundle.

# Your app's keystring, from the Etsy Developer Portal ("Your Apps").
# Also the OAuth client_id — PKCE is used, so no client secret is ever
# sent to the token endpoint.
ETSY_API_KEYSTRING=

# The shared secret from the same screen. Since Etsy's 9 February 2026
# change, every v3 request must carry BOTH halves:
#   x-api-key: <keystring>:<shared_secret>
# This is NOT an OAuth client secret and is never used as one.
ETSY_API_SHARED_SECRET=

# Our own shop's numeric id. Not a secret; kept here so every Etsy value
# lives in one place. Every receipt read is scoped to it, which is what
# makes "this order is not ours" a 404 rather than a judgement call.
ETSY_SHOP_ID=

# Where Etsy sends the family back. Must match an entry registered in the
# Developer Portal EXACTLY. Read from configuration and never derived
# from a request's Host header or a query parameter.
# e.g. https://<your-deployment>/api/etsy/callback
ETSY_OAUTH_REDIRECT_URI=

# BOOTSTRAP SEED ONLY, for the very first start of a deployment.
#
# Etsy rotates the seller refresh token on every refresh and revokes the
# previous one, so an environment variable cannot be the source of truth:
# the current credential lives in `etsy_seller_credentials` (see
# supabase/migrations/20260907120000_etsy_seller_credential.sql). This
# value is used ONLY to create that row the first time, via
# INSERT ... ON CONFLICT DO NOTHING — it can never overwrite a stored
# token, and once the row exists it is inert and may be removed.
ETSY_SELLER_REFRESH_TOKEN=
