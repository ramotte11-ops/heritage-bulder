# Heritage Hommage — environment variables
#
# Copy to .env.local for local development. Names only — never put a real
# value in this file or commit one anywhere. See README.md and
# supabase/README.md for how these are used.
#
# The app builds, runs, and serves its current pages with ALL of these
# unset. Nothing here is required until a future mission actually calls
# the Supabase adapters in lib/adapters/supabase/.

# --- Public: safe to expose in the browser -----------------------------
# Next.js only bundles env vars prefixed NEXT_PUBLIC_ into browser code.
# Everything below this section is server-only, automatically, as long as
# it is only read from server-side files (never imported into a
# "use client" component).

# Supabase project URL. Find it in the Supabase dashboard under
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key, from the same screen. Safe to expose:
# every request made with it is still subject to Row Level Security
# (see supabase/README.md) — it grants no access on its own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only: never prefix these NEXT_PUBLIC_ -----------------------

# Supabase service role key, from the same screen. BYPASSES Row Level
# Security entirely. Never expose this to the browser. Only used by
# lib/supabase/service-role-client.ts for trusted server-side operations
# — nothing calls it yet.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings -> Database),
# for migration tooling only — e.g.
# `psql "$SUPABASE_DB_URL" -f supabase/migrations/<file>.sql`.
# The application itself never reads this.
SUPABASE_DB_URL=
